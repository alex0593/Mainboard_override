<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash attributes only exist on API 31+; the base theme in values/ covers older devices. -->
    <style name="Theme.MainboardOverride.Starting" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
    </style>
</resources>
